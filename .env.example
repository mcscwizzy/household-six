# Copy to .env and review before deployment.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8088
# Replace with the trusted local HTTPS URL before using the app on your LAN.
APP_URL=https://householdsix.home.arpa:8443
DATA_PATH=household-six-data
BACKUP_PATH=household-six-backups
HOUSEHOLD_TIMEZONE=America/Chicago
SESSION_DAYS=14
CADDY_HOST=householdsix.home.arpa
CADDY_HTTPS_PORT=8443

# Optional integrations remain disabled unless deliberately configured.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_MODEL=qwen3.5:0.8b
AI_CONTEXT_LENGTH=4096
AI_TEMPERATURE=0.1
AI_MAX_CONCURRENT_JOBS=1
AI_REQUIRE_WRITE_CONFIRMATION=true
AI_ALLOW_CLOUD_FALLBACK=false
MCP_ENABLED=false
